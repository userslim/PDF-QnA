# Streamlit Secrets 配置文件模板
# 复制此文件为 .streamlit/secrets.toml 并填入你的 API Key
# 注意：secrets.toml 已被 .gitignore 忽略，不会上传到 GitHub

# 选项 1：Groq（推荐，免费层）
LLM_MODE = "groq"
GROQ_API_KEY = "gsk_your_key_here"
GROQ_MODEL = "llama-3.1-8b-instant"

# 选项 2：OpenAI
# LLM_MODE = "openai"
# OPENAI_API_KEY = "sk-your-key-here"
# OPENAI_MODEL = "gpt-4o-mini"

# 选项 3：本地 Ollama（默认，无需 API Key）
# LLM_MODE = "ollama"
# OLLAMA_BASE_URL = "http://localhost:11434"
# OLLAMA_MODEL = "llama3.1:8b"